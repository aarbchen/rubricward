{
  "openapi": "3.0.3",
  "info": {
    "title": "AIA G702 G703 Schedule of Values SOV & Retainage Billing Generator API",
    "version": "1.0.0",
    "description": "Convert construction bid items into a balanced, front-load-compliant AIA G702 Application for Payment and G703 Continuation Sheet with retainage math."
  },
  "servers": [
    {
      "url": "https://rubricward.com"
    }
  ],
  "paths": {
    "/v1/generate/aia-g702-g703-pay-app": {
      "post": {
        "summary": "Generate AIA G702 & G703 Schedule of Values Pay App",
        "description": "Convert construction bid items into a balanced, front-load-compliant AIA G702 Application for Payment and G703 Continuation Sheet with retainage math.",
        "operationId": "generateAiaG702G703PayApp",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_name",
                  "sov_lines"
                ],
                "properties": {
                  "project_name": {
                    "type": "string",
                    "description": "Construction contract title.",
                    "default": "Walnut Creek WWTP Rehab"
                  },
                  "application_number": {
                    "type": "integer",
                    "description": "Monthly progress pay application number.",
                    "default": 4
                  },
                  "retainage_pct": {
                    "type": "number",
                    "description": "Contract retainage withhold percentage.",
                    "default": 5.0
                  },
                  "sov_lines": {
                    "type": "array",
                    "description": "Schedule of Values line items with scheduled_value_usd, prev_completed_usd, this_period_usd, stored_materials_usd.",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              },
              "example": {
                "project_name": "City of Austin Walnut Creek WWTP Digester Rehab",
                "application_number": 4,
                "retainage_pct": 5.0,
                "sov_lines": [
                  {
                    "item_no": "01",
                    "description": "Mobilization, Bonds & Submittals",
                    "scheduled_value_usd": 380000,
                    "prev_completed_usd": 380000,
                    "this_period_usd": 0,
                    "stored_materials_usd": 0
                  },
                  {
                    "item_no": "02",
                    "description": "Cast-in-Place Structural Digester Wall Rehab",
                    "scheduled_value_usd": 1950000,
                    "prev_completed_usd": 820000,
                    "this_period_usd": 465000,
                    "stored_materials_usd": 115000
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful structured preconstruction JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Verify API Gateway Health Status",
        "description": "Unprotected SLA and health-check endpoint returning HTTP 200 OK.",
        "operationId": "getHealthCheckStatus",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}