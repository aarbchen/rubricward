{
  "openapi": "3.0.3",
  "info": {
    "title": "Specialty Group EIN NPI Payer Leverage & Revenue Left on Table RLOT API",
    "version": "1.0.0",
    "description": "Compare a medical group or ASC's contracted CPT/APC fee schedule against regional peer EIN/NPI groups in the same MSA using CMS TiC MRF files to quantify annual RLOT."
  },
  "servers": [
    {
      "url": "https://rubricward.com"
    }
  ],
  "paths": {
    "/v1/analyze/planholder-competitor-spread": {
      "post": {
        "summary": "Analyze Specialty Group EIN/NPI Payer Leverage & RLOT",
        "description": "Compare a medical group or ASC's contracted CPT/APC fee schedule against regional peer EIN/NPI groups in the same MSA using CMS TiC MRF files to quantify annual RLOT.",
        "operationId": "analyzeSpecialtyGroupPayerRlot",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_id",
                  "engineers_estimate_usd"
                ],
                "properties": {
                  "project_id": {
                    "type": "string",
                    "description": "Regional Market MRF Cohort ID.",
                    "default": "TXDOI-MRF-CPT-29881-DFW"
                  },
                  "engineers_estimate_usd": {
                    "type": "number",
                    "description": "Annual cohort commercial revenue at 75th-percentile regional MRF benchmark in USD.",
                    "default": 2450000
                  }
                }
              },
              "example": {
                "project_id": "TXDOI-MRF-CPT-29881-DFW",
                "engineers_estimate_usd": 2450000
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful structured healthcare payer MRF & IDR JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Verify API Gateway Health Status",
        "description": "Unprotected SLA and health-check endpoint returning HTTP 200 OK.",
        "operationId": "getHealthCheckStatus",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}