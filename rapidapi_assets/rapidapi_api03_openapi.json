{
  "openapi": "3.0.3",
  "info": {
    "title": "CMS Medicare Physician Fee Schedule MPFS RVU GPCI & ASC Calculator API",
    "version": "1.0.0",
    "description": "Calculate locality-adjusted CMS Medicare Physician Fee Schedule (MPFS) Work/PE/MP RVU rates, GPCI locality multipliers, and commercial percent-of-Medicare schedules."
  },
  "servers": [
    {
      "url": "https://rubricward.com"
    }
  ],
  "paths": {
    "/v1/calculate/davis-bacon-prevailing-wage": {
      "post": {
        "summary": "Calculate CMS Medicare MPFS RVU & GPCI Locality Schedule",
        "description": "Calculate locality-adjusted CMS Medicare Physician Fee Schedule (MPFS) Work/PE/MP RVU rates, GPCI locality multipliers, and commercial percent-of-Medicare schedules.",
        "operationId": "calculateMedicareMpfsRvuGpci",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "state_code",
                  "county"
                ],
                "properties": {
                  "state_code": {
                    "type": "string",
                    "description": "Two-letter U.S. state code.",
                    "default": "TX"
                  },
                  "county": {
                    "type": "string",
                    "description": "CMS Medicare GPCI locality or county name.",
                    "default": "Dallas / Tarrant County (DFW Locality)"
                  },
                  "construction_type": {
                    "type": "string",
                    "description": "Place of Service setting (ASC / Outpatient Facility, HOPD, Inpatient, Office).",
                    "default": "ASC / Outpatient Facility"
                  },
                  "estimated_crew_hours": {
                    "type": "integer",
                    "description": "Total annual claim encounters across the specialty cohort.",
                    "default": 1250
                  }
                }
              },
              "example": {
                "state_code": "TX",
                "county": "Dallas / Tarrant County (DFW Locality)",
                "construction_type": "ASC / Outpatient Facility",
                "estimated_crew_hours": 1250
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful structured healthcare payer MRF & IDR JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Verify API Gateway Health Status",
        "description": "Unprotected SLA and health-check endpoint returning HTTP 200 OK.",
        "operationId": "getHealthCheckStatus",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}