{
  "openapi": "3.0.3",
  "info": {
    "title": "Build America Buy America BABA & 23 CFR 635.410 Material Auditor API",
    "version": "1.0.0",
    "description": "Audit construction Bills of Materials against Build America, Buy America (BABA) and FHWA 23 CFR 635.410 domestic iron, steel, and manufactured product rules."
  },
  "servers": [
    {
      "url": "https://rubricward.com"
    }
  ],
  "paths": {
    "/v1/audit/baba-buy-america": {
      "post": {
        "summary": "Audit BABA & Buy America Material Compliance",
        "description": "Audit construction Bills of Materials against Build America, Buy America (BABA) and FHWA 23 CFR 635.410 domestic iron, steel, and manufactured product rules.",
        "operationId": "auditBabaBuyAmerica",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_name",
                  "bom_items"
                ],
                "properties": {
                  "project_name": {
                    "type": "string",
                    "description": "Infrastructure project title.",
                    "default": "PennDOT I-81 Bridge Replacement"
                  },
                  "funding_agency": {
                    "type": "string",
                    "description": "Federal funding agency (FHWA, FTA, EPA SRF, USACE).",
                    "default": "FHWA / DOT"
                  },
                  "bom_items": {
                    "type": "array",
                    "description": "Bill of Materials items with category, origin, domestic_cost_pct, and extended_cost_usd.",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              },
              "example": {
                "project_name": "PennDOT I-81 Composite Bridge Deck Replacement",
                "funding_agency": "FHWA / DOT",
                "bom_items": [
                  {
                    "material_name": "ASTM A709 Grade 50W Structural Steel Plate Girders",
                    "category": "Iron/Steel",
                    "country_of_melt_and_pour": "US",
                    "domestic_cost_pct": 100.0,
                    "extended_cost_usd": 1420000
                  },
                  {
                    "material_name": "Elastomeric Bridge Bearing Pads",
                    "category": "Construction Material",
                    "country_of_melt_and_pour": "US",
                    "domestic_cost_pct": 92.0,
                    "extended_cost_usd": 84000
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful structured preconstruction JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Verify API Gateway Health Status",
        "description": "Unprotected SLA and health-check endpoint returning HTTP 200 OK.",
        "operationId": "getHealthCheckStatus",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}