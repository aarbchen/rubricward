{
  "openapi": "3.0.3",
  "info": {
    "title": "DOT DBE 49 CFR Part 26 Subcontractor & Good Faith Effort Generator API",
    "version": "1.0.0",
    "description": "Calculate certified DBE/MBE/WBE participation credit (100% subcontractor vs. 60% regular dealer) and generate audit-proof 49 CFR Part 26 Good Faith Effort logs."
  },
  "servers": [
    {
      "url": "https://rubricward.com"
    }
  ],
  "paths": {
    "/v1/generate/dbe-good-faith-effort": {
      "post": {
        "summary": "Generate DOT DBE Participation & Good Faith Effort Log",
        "description": "Calculate certified DBE/MBE/WBE participation credit (100% subcontractor vs. 60% regular dealer) and generate audit-proof 49 CFR Part 26 Good Faith Effort logs.",
        "operationId": "generateDbeGoodFaithEffort",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "project_name",
                  "total_base_bid_usd",
                  "dbe_goal_percent",
                  "proposed_dbe_commitments"
                ],
                "properties": {
                  "project_name": {
                    "type": "string",
                    "description": "DOT or municipal project name.",
                    "default": "FDOT SR-826 Reconstruction"
                  },
                  "total_base_bid_usd": {
                    "type": "number",
                    "description": "Total prime contractor base bid in USD.",
                    "default": 14850000
                  },
                  "dbe_goal_percent": {
                    "type": "number",
                    "description": "Mandatory DBE goal percentage (e.g., 11.5).",
                    "default": 11.5
                  },
                  "proposed_dbe_commitments": {
                    "type": "array",
                    "description": "List of DBE firms, role (Subcontractor/Regular Dealer), and quote_amount_usd.",
                    "items": {
                      "type": "object"
                    }
                  }
                }
              },
              "example": {
                "project_name": "FDOT SR-826 Palmetto Expressway Interchange Reconstruction",
                "total_base_bid_usd": 14850000,
                "dbe_goal_percent": 11.5,
                "proposed_dbe_commitments": [
                  {
                    "firm_name": "Sunshine Barricade & MOT LLC",
                    "certification": "FDOT DBE",
                    "role": "Subcontractor",
                    "work_scope": "Maintenance of Traffic & Pavement Markings",
                    "quote_amount_usd": 1180000
                  },
                  {
                    "firm_name": "Gulfstream Aggregate Supply Inc.",
                    "certification": "FDOT DBE",
                    "role": "Regular Dealer",
                    "work_scope": "Limestone Base & Pipe Bedding",
                    "quote_amount_usd": 920000
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful structured preconstruction JSON response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "summary": "Verify API Gateway Health Status",
        "description": "Unprotected SLA and health-check endpoint returning HTTP 200 OK.",
        "operationId": "getHealthCheckStatus",
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}